{
  "uid": "valkey-managed",
  "title": "Managed Valkey",
  "description": "Shared Timeweb Valkey: availability, capacity, errors and persistence.",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "timezone": "browser",
  "tags": [
    "valkey",
    "timeweb",
    "shared"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Valkey availability",
      "type": "stat",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "description": "1 = exporter reached Valkey; 0 = database probe failed; absent = unknown, inspect collection.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "redis_up{service_name=\"timeweb-dbaas-valkey\"}",
          "legendFormat": "Valkey",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "Database metrics HTTP availability",
      "type": "stat",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "description": "HTTP success does not imply a successful database scrape.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{service_name=\"timeweb-dbaas-valkey\"}",
          "legendFormat": "Exporter HTTP",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          }
        },
        {
          "refId": "B",
          "expr": "redis_exporter_last_scrape_error{service_name=\"timeweb-dbaas-valkey\"}",
          "legendFormat": "Scrape error (0 = healthy)",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "Host metrics HTTP availability",
      "type": "stat",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "description": "Independent of the database metrics endpoint.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{service_name=\"timeweb-dbaas-valkey-node\"}",
          "legendFormat": "Host exporter HTTP",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "id": 4,
      "title": "Database sample age",
      "type": "stat",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "description": "A missing sample is unknown, never zero. Scrapes run every 30 seconds; more than 180 seconds is stale.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - timestamp(redis_up{service_name=\"timeweb-dbaas-valkey\"})",
          "legendFormat": "Latest sample age",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "id": 5,
      "title": "Memory counted against maxmemory",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "description": "Subtracts buffers excluded from eviction accounting. Alerts: >80% for 10m, >90% for 5m. Uses the actual maxmemory, not tariff RAM.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * clamp_min(redis_memory_used_bytes{service_name=\"timeweb-dbaas-valkey\"} - redis_mem_not_counted_for_eviction_bytes{service_name=\"timeweb-dbaas-valkey\"}, 0) / (redis_memory_max_bytes{service_name=\"timeweb-dbaas-valkey\"} > 0)",
          "legendFormat": "Accounted memory / maxmemory",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "id": 6,
      "title": "Memory footprint and limit",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "redis_memory_used_bytes{service_name=\"timeweb-dbaas-valkey\"}",
          "legendFormat": "Used",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          }
        },
        {
          "refId": "B",
          "expr": "redis_memory_used_rss_bytes{service_name=\"timeweb-dbaas-valkey\"}",
          "legendFormat": "RSS",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          }
        },
        {
          "refId": "C",
          "expr": "redis_memory_max_bytes{service_name=\"timeweb-dbaas-valkey\"}",
          "legendFormat": "maxmemory",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          }
        },
        {
          "refId": "D",
          "expr": "redis_mem_not_counted_for_eviction_bytes{service_name=\"timeweb-dbaas-valkey\"}",
          "legendFormat": "Excluded buffers",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "id": 7,
      "title": "Server uptime",
      "type": "stat",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
