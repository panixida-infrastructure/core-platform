      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 8,
        "h": 8
      },
      "description": "Server execution time only, excluding network/queue time. Alert evaluates commands with >=100 calls/5m and mean >50ms for 10m; this is not p95 or p99.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
