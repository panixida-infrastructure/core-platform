      "targets": [
        {
          "refId": "A",
          "expr": "redis_uptime_in_seconds{service_name=\"timeweb-dbaas-valkey\"}",
          "legendFormat": "Uptime",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "id": 8,
      "title": "Observed restarts in 30 minutes",
      "type": "stat",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 8,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "description": "Based on observed uptime decreases; restarts during missing telemetry can be missed.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "resets(redis_uptime_in_seconds{service_name=\"timeweb-dbaas-valkey\"}[30m])",
          "legendFormat": "Uptime resets",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          }
        }
      ]
    },
    {
      "id": 9,
      "title": "OOM and write failures",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 16,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "description": "Error counters may not exist before the first error. Zero fallback is allowed only with a fresh healthy database probe. Command failures are not separated by application.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(redis_errors_total{service_name=\"timeweb-dbaas-valkey\",err=\"OOM\"}[5m])) or (0 * (max(redis_up{service_name=\"timeweb-dbaas-valkey\"} and (time() - timestamp(redis_up{service_name=\"timeweb-dbaas-valkey\"}) < 180)) == 1))",
          "legendFormat": "OOM",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (cmd) (rate({__name__=~\"redis_commands_(failed|rejected)_calls_total\",service_name=\"timeweb-dbaas-valkey\",cmd=~\"set.*|mset.*|hset.*|incr.*|decr.*|del|unlink|expire.*|pexpire.*|eval.*|fcall.*|lpush.*|rpush.*|sadd|zadd\"}[5m])) or (0 * (max(redis_up{service_name=\"timeweb-dbaas-valkey\"} and (time() - timestamp(redis_up{service_name=\"timeweb-dbaas-valkey\"}) < 180)) == 1))",
          "legendFormat": "{{cmd}}",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "victoriametrics"
          }
        }
      ]
    },
