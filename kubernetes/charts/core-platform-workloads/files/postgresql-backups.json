{
  "uid": "postgresql-backups",
  "title": "PostgreSQL Backups",
  "description": "Timeweb managed PostgreSQL physical backups: automatic schedule, separate automatic/manual freshness, provider inventory and polling health.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "1m",
  "timezone": "browser",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "tags": [
    "core-platform",
    "postgresql",
    "backups",
    "timeweb"
  ],
  "templating": {
    "list": []
  },
  "links": [
    {
      "title": "Managed PostgreSQL",
      "type": "link",
      "keepTime": true,
      "url": "/d/postgresql-managed/postgresql-managed"
    },
    {
      "title": "Core Platform Overview",
      "type": "link",
      "keepTime": true,
      "url": "/d/core-platform-overview/core-platform-overview"
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Backup API polling",
      "description": "Successful complete API poll and data less than one hour old. Missing data is unknown, not healthy.",
      "type": "stat",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No data",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Unavailable",
                  "color": "red"
                },
                "1": {
                  "text": "OK",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "timeweb_postgres_backup_poll_success * on (db_cluster_id) group_left() ((time() - timeweb_postgres_backup_poll_last_success_timestamp_seconds) < bool 3600)",
          "legendFormat": "{{db_cluster}}",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "title": "Automatic backups",
      "description": "Provider schedule setting. Unknown while polling fails or data is stale.",
      "type": "stat",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No data",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Disabled",
                  "color": "red"
                },
                "1": {
                  "text": "Enabled",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "timeweb_postgres_backup_auto_enabled and on (db_cluster_id) (timeweb_postgres_backup_poll_success == 1) and on (db_cluster_id) (time() - timeweb_postgres_backup_poll_last_success_timestamp_seconds < 3600)",
          "legendFormat": "{{db_cluster}}",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "title": "Last successful automatic copy",
      "description": "Creation time of the newest physical backup currently in done state. Not a completion timestamp or restore verification. No data if no such copy exists or polling is unavailable.",
      "type": "stat",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso",
          "noValue": "No data",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(timeweb_postgres_backup_last_success_timestamp_seconds{backup_type=\"auto\"} > 0) * 1000 and on (db_cluster_id) (timeweb_postgres_backup_poll_success == 1) and on (db_cluster_id) (time() - timeweb_postgres_backup_poll_last_success_timestamp_seconds < 3600)",
          "legendFormat": "{{db_cluster}}",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "title": "Last successful manual copy",
      "description": "Creation time of the newest physical backup currently in done state. Not a completion timestamp or restore verification. No data if no such copy exists or polling is unavailable.",
      "type": "stat",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso",
          "noValue": "No data",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(timeweb_postgres_backup_last_success_timestamp_seconds{backup_type=\"manual\"} > 0) * 1000 and on (db_cluster_id) (timeweb_postgres_backup_poll_success == 1) and on (db_cluster_id) (time() - timeweb_postgres_backup_poll_last_success_timestamp_seconds < 3600)",
          "legendFormat": "{{db_cluster}}",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "title": "Completed copies",
      "description": "Completed automatic and manual physical copies in the provider inventory. In-progress copies do not count.",
      "type": "stat",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No data",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (db_cluster_id, db_cluster) (timeweb_postgres_backup_count{status=\"done\"}) and on (db_cluster_id) (timeweb_postgres_backup_poll_success == 1) and on (db_cluster_id) (time() - timeweb_postgres_backup_poll_last_success_timestamp_seconds < 3600)",
          "legendFormat": "{{db_cluster}}",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 6,
      "title": "Automatic retention",
      "description": "Configured number of retained automatic copies; manual copies are additional.",
      "type": "stat",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No data",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "timeweb_postgres_backup_retention_copies and on (db_cluster_id) (timeweb_postgres_backup_poll_success == 1) and on (db_cluster_id) (time() - timeweb_postgres_backup_poll_last_success_timestamp_seconds < 3600)",
          "legendFormat": "{{db_cluster}}",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 7,
      "title": "Age of successful copies",
      "description": "Automatic and manual copies are independent. A manual copy does not reset automatic freshness. The default automatic age limit is 36 hours. Gaps indicate unavailable monitoring or absent successful copies.",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 16,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 5,
            "spanNulls": false,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Automatic age limit"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(time() - (timeweb_postgres_backup_last_success_timestamp_seconds > 0)) / 3600 and on (db_cluster_id) (timeweb_postgres_backup_poll_success == 1) and on (db_cluster_id) (time() - timeweb_postgres_backup_poll_last_success_timestamp_seconds < 3600)",
          "legendFormat": "{{backup_type}}",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "expr": "timeweb_postgres_backup_max_age_seconds / 3600",
          "legendFormat": "Automatic age limit",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "title": "Physical backup inventory",
      "description": "Provider inventory by backup type and state. Only done is treated as successful.",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 16,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 5,
            "spanNulls": false,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "timeweb_postgres_backup_count{status=~\"done|fail|create|precreate\"} and on (db_cluster_id) (timeweb_postgres_backup_poll_success == 1) and on (db_cluster_id) (time() - timeweb_postgres_backup_poll_last_success_timestamp_seconds < 3600)",
          "legendFormat": "{{backup_type}} / {{status}}",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "title": "Latest attempt failed",
      "description": "Latest attempt checked separately for auto and manual. Older failures are superseded by newer attempts.",
      "type": "stat",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No data",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "No"
                },
                "1": {
                  "text": "Failed",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "timeweb_postgres_backup_last_attempt_failed and on (db_cluster_id) (timeweb_postgres_backup_poll_success == 1) and on (db_cluster_id) (time() - timeweb_postgres_backup_poll_last_success_timestamp_seconds < 3600)",
          "legendFormat": "{{backup_type}}",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 10,
      "title": "Time since last successful API poll",
      "description": "Polling runs every 15 minutes. MonitoringStalled warns after more than one hour without a complete successful poll, sustained for five minutes.",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 16,
        "y": 13,
        "w": 8,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 3600
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 5,
            "spanNulls": false,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - (timeweb_postgres_backup_poll_last_success_timestamp_seconds > 0)",
          "legendFormat": "{{db_cluster}}",
          "instant": false,
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "type": "text",
      "title": "How to read this dashboard",
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 5
      },
      "options": {
        "mode": "markdown",
        "content": "Timeweb creates the physical backups. This collector only reads the API.\n\nAutomatic schedule: **daily**, configured retention: **one automatic copy**. Manual copies are tracked separately.\n\n**No data** is not a healthy backup result: check API polling first. Successful means provider status `done`; restoration is not tested by these metrics. Dates use `created_at`."
      }
    }
  ]
}
