  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "victoriametrics"
        },
        "definition": "label_values({service_namespace=\"browser\",__name__=~\"aspnetcore_components_navigate_total|http_client_request_duration_seconds_count|browser_page_navigation_duration_seconds_count\"}, service_name)",
        "hide": 0,
        "includeAll": true,
        "label": "Service",
        "multi": true,
        "name": "service",
        "options": [],
        "query": "label_values({service_namespace=\"browser\",__name__=~\"aspnetcore_components_navigate_total|http_client_request_duration_seconds_count|browser_page_navigation_duration_seconds_count\"}, service_name)",
        "refresh": 1,
        "regex": "",
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "victoriametrics"
        },
        "definition": "label_values({service_namespace=\"browser\",service_name=~\"${service:regex}\",__name__=~\"aspnetcore_components_navigate_total|http_client_request_duration_seconds_count|browser_page_navigation_duration_seconds_count\"}, deployment_environment_name)",
        "hide": 0,
        "includeAll": true,
        "label": "Environment",
        "multi": true,
        "name": "environment",
        "options": [],
        "query": "label_values({service_namespace=\"browser\",service_name=~\"${service:regex}\",__name__=~\"aspnetcore_components_navigate_total|http_client_request_duration_seconds_count|browser_page_navigation_duration_seconds_count\"}, deployment_environment_name)",
        "refresh": 1,
        "regex": "",
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "victoriametrics"
        },
        "definition": "label_values({service_namespace=\"browser\",service_name=~\"${service:regex}\",deployment_environment_name=~\"${environment:regex}\",__name__=~\"aspnetcore_components_navigate_total|http_client_request_duration_seconds_count|browser_page_navigation_duration_seconds_count\"}, service_instance_id)",
        "hide": 0,
        "includeAll": true,
        "label": "Runtime instance",
        "multi": true,
        "name": "instance",
        "options": [],
        "query": "label_values({service_namespace=\"browser\",service_name=~\"${service:regex}\",deployment_environment_name=~\"${environment:regex}\",__name__=~\"aspnetcore_components_navigate_total|http_client_request_duration_seconds_count|browser_page_navigation_duration_seconds_count\"}, service_instance_id)",
        "refresh": 1,
        "regex": "",
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "victoriametrics"
        },
        "definition": "label_values({service_namespace=\"browser\",service_name=~\"${service:regex}\",deployment_environment_name=~\"${environment:regex}\",service_instance_id=~\"${instance:regex}\",__name__=~\"browser_page_navigation_duration_seconds_count|browser_page_http_duration_seconds_count|browser_web_vital_lcp_seconds\"}, page_route)",
        "hide": 0,
        "includeAll": true,
        "label": "Page",
        "multi": true,
        "name": "page",
        "options": [],
        "query": "label_values({service_namespace=\"browser\",service_name=~\"${service:regex}\",deployment_environment_name=~\"${environment:regex}\",service_instance_id=~\"${instance:regex}\",__name__=~\"browser_page_navigation_duration_seconds_count|browser_page_http_duration_seconds_count|browser_web_vital_lcp_seconds\"}, page_route)",
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query",
        "description": "Matched Blazor route template. Filters page transitions, page HTTP, route counts and document entry-page panels; component and log panels retain their own scope."
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Recently reporting runtimes (3 min)",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "count by (service_name) (max by (service_name, service_instance_id) (timestamp(aspnetcore_components_navigate_total{service_namespace=\"browser\",service_name=~\"${service:regex}\",deployment_environment_name=~\"${environment:regex}\",service_instance_id=~\"${instance:regex}\"})) > time() - 180)",
          "legendFormat": "{{service_name}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "description": "Runtimes reporting within three minutes, not users or online sessions. Closed, sleeping or throttled tabs can stop reporting. Empty does not mean an outage."
    },
    {
      "id": 2,
      "title": "Browser metric series (recently reporting)",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "count by (service_name) ({service_namespace=\"browser\",service_name=~\"${service:regex}\",deployment_environment_name=~\"${environment:regex}\",service_instance_id=~\"${instance:regex}\"} and (time() - timestamp({service_namespace=\"browser\",service_name=~\"${service:regex}\",deployment_environment_name=~\"${environment:regex}\",service_instance_id=~\"${instance:regex}\"}) < 180))",
          "legendFormat": "{{service_name}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "description": "Live metric series, not retained storage volume. Each runtime GUID and histogram bucket creates series. Dashboard aggregation does not reduce ingestion cardinality."
    },
    {
      "id": 20,
      "title": "Page transitions — WASM navigation",
      "type": "row",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 8
      }
    },
    {
      "id": 21,
      "title": "Page transition to first frame p95",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "topk(10, histogram_quantile(0.95, sum by (le, service_name, deployment_environment_name, page_route) (rate(browser_page_navigation_duration_seconds_bucket{service_namespace=\"browser\",service_name=~\"${service:regex}\",deployment_environment_name=~\"${environment:regex}\",service_instance_id=~\"${instance:regex}\",page_route=~\"${page:regex}\",browser_navigation_type=\"navigation\",browser_navigation_phase=\"first_frame\"}[5m]))))",
          "legendFormat": "{{service_name}} {{deployment_environment_name}} {{page_route}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "description": "Destination route; top 10 p95 values over 5 minutes. Time from committed navigation to a rendering opportunity. A loading indicator can be that first frame; compare page HTTP below for data loading. Missing samples stay empty; no zero is invented."
    },
    {
      "id": 22,
      "title": "Page HTTP request duration p95",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "topk(10, histogram_quantile(0.95, sum by (le, service_name, deployment_environment_name, page_route) (rate(browser_page_http_duration_seconds_bucket{service_namespace=\"browser\",service_name=~\"${service:regex}\",deployment_environment_name=~\"${environment:regex}\",service_instance_id=~\"${instance:regex}\",page_route=~\"${page:regex}\"}[5m]))))",
          "legendFormat": "{{service_name}} {{deployment_environment_name}} {{page_route}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "description": "Outgoing HTTP duration by the page on which the request started, including requests that finish after a navigation. Telemetry export is excluded by Core. Top 10 p95 over 5 minutes; this is per-request duration, not total page-ready time."
    },
    {
      "id": 23,
      "title": "Page routing and render-frame p95",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "topk(10, histogram_quantile(0.95, sum by (le, service_name, deployment_environment_name, page_route, browser_navigation_phase) (rate(browser_page_navigation_duration_seconds_bucket{service_namespace=\"browser\",service_name=~\"${service:regex}\",deployment_environment_name=~\"${environment:regex}\",service_instance_id=~\"${instance:regex}\",page_route=~\"${page:regex}\",browser_navigation_type=\"navigation\",browser_navigation_phase=~\"route_match|render_frame\"}[5m]))))",
          "legendFormat": "{{service_name}} {{deployment_environment_name}} {{page_route}} {{browser_navigation_phase}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "description": "route_match: navigation event to framework route match. render_frame: route match to a rendering opportunity. Both are measured separately; percentiles must not be added. Async data loading may continue after either phase."
    },
    {
      "id": 24,
      "title": "Observed page transitions and HTTP requests / 10 min",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (service_name, deployment_environment_name, page_route) (increase(browser_page_navigation_duration_seconds_count{service_namespace=\"browser\",service_name=~\"${service:regex}\",deployment_environment_name=~\"${environment:regex}\",service_instance_id=~\"${instance:regex}\",page_route=~\"${page:regex}\",browser_navigation_type=\"navigation\",browser_navigation_phase=\"first_frame\"}[10m]))",
          "legendFormat": "{{service_name}} {{deployment_environment_name}} {{page_route}} transitions",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "expr": "sum by (service_name, deployment_environment_name, page_route) (increase(browser_page_http_duration_seconds_count{service_namespace=\"browser\",service_name=~\"${service:regex}\",deployment_environment_name=~\"${environment:regex}\",service_instance_id=~\"${instance:regex}\",page_route=~\"${page:regex}\"}[10m]))",
          "legendFormat": "{{service_name}} {{deployment_environment_name}} {{page_route}} HTTP",
          "refId": "B",
          "range": true,
          "instant": false
        }
      ],
      "description": "Measurement counts give context for latency percentiles. Only completed navigation frames count. Increase requires exported counter samples; the first observation can be undercounted. Empty means no observations, not an application outage."
    },
    {
      "id": 30,
      "title": "Document startup and Web Vitals — entry page",
      "type": "row",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 25
      }
    },
    {
      "id": 31,
      "title": "WASM startup p95 — reporting runtimes",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "topk(10, histogram_quantile(0.95, sum by (le, service_name, deployment_environment_name, page_route, browser_wasm_phase) (browser_wasm_startup_duration_seconds_bucket{service_namespace=\"browser\",service_name=~\"${service:regex}\",deployment_environment_name=~\"${environment:regex}\",service_instance_id=~\"${instance:regex}\",page_route=~\"${page:regex}\"} and (time() - timestamp(browser_wasm_startup_duration_seconds_bucket{service_namespace=\"browser\",service_name=~\"${service:regex}\",deployment_environment_name=~\"${environment:regex}\",service_instance_id=~\"${instance:regex}\",page_route=~\"${page:regex}\"}) < 180))))",
          "legendFormat": "{{service_name}} {{deployment_environment_name}} {{page_route}} {{browser_wasm_phase}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "description": "Startup duration distribution across runtimes reporting within the last 3 minutes, grouped by document entry route and phase. Each runtime contributes one startup observation per phase; this is not a count of recent page loads. Runtime and document-to-runtime phases overlap. First frame is a rendering opportunity after runtime startup, not completion of asynchronous page data."
    },
    {
      "id": 32,
      "title": "Latest Web Vitals p75 — reporting runtimes",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "quantile by (service_name, deployment_environment_name, page_route) (0.75, (browser_web_vital_lcp_seconds{service_namespace=\"browser\",service_name=~\"${service:regex}\",deployment_environment_name=~\"${environment:regex}\",service_instance_id=~\"${instance:regex}\",page_route=~\"${page:regex}\"} and (time() - timestamp(browser_web_vital_lcp_seconds{service_namespace=\"browser\",service_name=~\"${service:regex}\",deployment_environment_name=~\"${environment:regex}\",service_instance_id=~\"${instance:regex}\",page_route=~\"${page:regex}\"}) < 180)))",
          "legendFormat": "{{service_name}} {{deployment_environment_name}} {{page_route}} LCP",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "expr": "quantile by (service_name, deployment_environment_name, page_route) (0.75, (browser_web_vital_fcp_seconds{service_namespace=\"browser\",service_name=~\"${service:regex}\",deployment_environment_name=~\"${environment:regex}\",service_instance_id=~\"${instance:regex}\",page_route=~\"${page:regex}\"} and (time() - timestamp(browser_web_vital_fcp_seconds{service_namespace=\"browser\",service_name=~\"${service:regex}\",deployment_environment_name=~\"${environment:regex}\",service_instance_id=~\"${instance:regex}\",page_route=~\"${page:regex}\"}) < 180)))",
          "legendFormat": "{{service_name}} {{deployment_environment_name}} {{page_route}} FCP",
          "refId": "B",
          "range": true,
          "instant": false
        },
        {
          "expr": "quantile by (service_name, deployment_environment_name, page_route) (0.75, (browser_web_vital_ttfb_seconds{service_namespace=\"browser\",service_name=~\"${service:regex}\",deployment_environment_name=~\"${environment:regex}\",service_instance_id=~\"${instance:regex}\",page_route=~\"${page:regex}\"} and (time() - timestamp(browser_web_vital_ttfb_seconds{service_namespace=\"browser\",service_name=~\"${service:regex}\",deployment_environment_name=~\"${environment:regex}\",service_instance_id=~\"${instance:regex}\",page_route=~\"${page:regex}\"}) < 180)))",
          "legendFormat": "{{service_name}} {{deployment_environment_name}} {{page_route}} TTFB",
          "refId": "C",
          "range": true,
          "instant": false
        },
        {
          "expr": "quantile by (service_name, deployment_environment_name, page_route) (0.75, (browser_web_vital_inp_seconds{service_namespace=\"browser\",service_name=~\"${service:regex}\",deployment_environment_name=~\"${environment:regex}\",service_instance_id=~\"${instance:regex}\",page_route=~\"${page:regex}\"} and (time() - timestamp(browser_web_vital_inp_seconds{service_namespace=\"browser\",service_name=~\"${service:regex}\",deployment_environment_name=~\"${environment:regex}\",service_instance_id=~\"${instance:regex}\",page_route=~\"${page:regex}\"}) < 180)))",
          "legendFormat": "{{service_name}} {{deployment_environment_name}} {{page_route}} INP",
          "refId": "D",
          "range": true,
          "instant": false
        }
      ],
      "description": "p75 of latest document measurements among runtimes reporting in the last 3 minutes, grouped by document entry route. This is not a page-load distribution or a percentile of individual Blazor route transitions. INP is absent until an interaction is measured."
    },
    {
      "id": 33,
      "title": "Latest CLS p75 — reporting runtimes",
      "type": "timeseries",
      "datasource": {
