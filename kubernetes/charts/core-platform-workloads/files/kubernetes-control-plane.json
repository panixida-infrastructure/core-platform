{
  "uid": "kubernetes-control-plane",
  "title": "Kubernetes Control Plane",
  "description": "Timeweb managed master: host OS metrics, API server metrics and provider logs. OOM is a host counter; correlate increments with process restarts. No control-plane host agent is installed.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "core-platform",
    "kubernetes",
    "control-plane"
  ],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "API available",
      "description": "Green: API metrics are reachable (1). Red: unreachable (0). ControlPlaneApiServerDown fires after 2 minutes of unavailability.",
      "type": "stat",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{service_name=\"timeweb-kubernetes-apiserver\"}",
          "legendFormat": "",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "title": "Master memory available",
      "description": "Available RAM in bytes. Green: at least 10% of total RAM remains available. Red: less than 10%, matching the HostHighMemory condition (more than 90% used for 10 minutes). Total RAM is queried from the master so colors follow capacity changes.",
      "type": "stat",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "percentage",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 10 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_MemAvailable_bytes{service_name=\"timeweb-kubernetes-node\"} and (node_memory_MemTotal_bytes{service_name=\"timeweb-kubernetes-node\"} > 0)",
          "legendFormat": "",
          "range": false,
          "instant": true
        },
        {
          "refId": "B",
          "expr": "(node_memory_MemTotal_bytes{service_name=\"timeweb-kubernetes-node\"} > 0) and node_memory_MemAvailable_bytes{service_name=\"timeweb-kubernetes-node\"}",
          "legendFormat": "Total memory",
          "range": false,
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "configFromData",
          "options": {
            "configRefId": "B",
            "applyTo": {
              "id": "byType",
              "options": "number"
            },
            "mappings": [
              {
                "fieldName": "Total memory",
                "handlerKey": "max",
                "reducerId": "lastNotNull"
              }
            ]
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "title": "API resident memory",
      "description": "Physical RAM used by the API server process. Blue is informational: RSS alone has no universal unhealthy threshold. Correlate growth with available host RAM, OOM events and restarts.",
      "type": "stat",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{service_name=\"timeweb-kubernetes-apiserver\"}",
          "legendFormat": "",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "title": "Host OOM kills since boot",
      "description": "Historical OOM kills since the master booted. Green: none. Yellow: at least one occurred; this does not imply an ongoing shortage. ControlPlaneOomKill alerts on new kills within the last 10 minutes.",
      "type": "stat",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_vmstat_oom_kill{service_name=\"timeweb-kubernetes-node\"}",
          "legendFormat": "",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "title": "API process uptime",
      "description": "Time since the API server process started. Blue is informational: longer uptime is normal. ControlPlaneApiServerRestarted detects changes in process start time over 10 minutes; planned maintenance can also reset uptime.",
      "type": "stat",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time()-process_start_time_seconds{service_name=\"timeweb-kubernetes-apiserver\"}",
          "legendFormat": "",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 6,
      "title": "Log collection delay",
      "description": "Time since the last successful control-plane log polling cycle. Green: less than 5 minutes. Red: 5 minutes or more. ControlPlaneLogCollectionStalled alerts when the delay remains above 5 minutes for another 5 minutes.",
      "type": "stat",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 300 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time()-max(timeweb_control_plane_logs_last_success_timestamp_seconds)",
          "legendFormat": "",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 7,
      "title": "Master memory and API process",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_MemTotal_bytes{service_name=\"timeweb-kubernetes-node\"}",
          "legendFormat": "Total",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "node_memory_MemTotal_bytes{service_name=\"timeweb-kubernetes-node\"}-node_memory_MemAvailable_bytes{service_name=\"timeweb-kubernetes-node\"}",
          "legendFormat": "Host used (excluding available cache)",
          "range": true,
          "instant": false
        },
        {
          "refId": "C",
          "expr": "process_resident_memory_bytes{service_name=\"timeweb-kubernetes-apiserver\"}",
          "legendFormat": "API RSS",
          "range": true,
          "instant": false
        },
        {
          "refId": "D",
          "expr": "go_memstats_heap_alloc_bytes{service_name=\"timeweb-kubernetes-apiserver\"}",
          "legendFormat": "API Go heap",
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "title": "Master CPU",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100*(1-avg(rate(node_cpu_seconds_total{service_name=\"timeweb-kubernetes-node\",mode=\"idle\"}[$__rate_interval])))",
          "legendFormat": "CPU used",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "100*rate(process_cpu_seconds_total{service_name=\"timeweb-kubernetes-apiserver\"}[$__rate_interval])/scalar(count(node_cpu_seconds_total{service_name=\"timeweb-kubernetes-node\",mode=\"idle\"}))",
          "legendFormat": "API share of host CPU",
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "title": "API requests by resource",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10,sum by(resource,verb)(rate(apiserver_request_total{service_name=\"timeweb-kubernetes-apiserver\"}[$__rate_interval])))",
          "legendFormat": "{{resource}} {{verb}}",
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "title": "API concurrent requests",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "apiserver_current_inflight_requests{service_name=\"timeweb-kubernetes-apiserver\"}",
          "legendFormat": "{{request_kind}}",
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "title": "API request p99 latency",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99,sum by(le,verb)(rate(apiserver_request_duration_seconds_bucket{service_name=\"timeweb-kubernetes-apiserver\",verb!=\"WATCH\"}[$__rate_interval])))",
          "legendFormat": "{{verb}}",
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 12,
      "title": "Objects stored by Kubernetes",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(12,apiserver_storage_objects{service_name=\"timeweb-kubernetes-apiserver\"})",
          "legendFormat": "{{resource}}",
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 13,
      "title": "New OOM kills and API restarts",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(node_vmstat_oom_kill{service_name=\"timeweb-kubernetes-node\"}[5m])",
          "legendFormat": "OOM kills / 5m",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "changes(process_start_time_seconds{service_name=\"timeweb-kubernetes-apiserver\"}[5m])",
          "legendFormat": "API restarts / 5m",
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 14,
      "title": "Master system disk",
      "type": "timeseries",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100*(1-node_filesystem_avail_bytes{service_name=\"timeweb-kubernetes-node\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"}/node_filesystem_size_bytes{service_name=\"timeweb-kubernetes-node\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"})",
          "legendFormat": "Filesystem used",
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 15,
      "title": "Managed control-plane logs",
      "type": "logs",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victorialogs"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 24,
        "h": 12
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "\"log.source\":=\"timeweb-api\" \"platform.name\":=\"core-platform\"",
          "query": "\"log.source\":=\"timeweb-api\" \"platform.name\":=\"core-platform\""
        }
      ]
    }
  ]
}
