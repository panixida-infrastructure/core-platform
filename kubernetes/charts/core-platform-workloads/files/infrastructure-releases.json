{
  "infrastructureNamespaces": [
    "argocd",
    "cert-manager",
    "csi-driver-timeweb-cloud",
    "envoy-gateway-system",
    "external-secrets",
    "headlamp",
    "identity",
    "kargo",
    "kube-system",
    "observability",
    "quality",
    "secrets"
  ],
  "providerNamespaces": [
    "kube-system",
    "csi-driver-timeweb-cloud"
  ],
  "ownImagePrefixes": [
    "ghcr.io/panixida-infrastructure/"
  ],
  "components": [
    {
      "name": "SonarQube Community Build",
      "installed": {
        "imagePattern": "(?:public\\.ecr\\.aws|ecr-public\\.aws\\.com)/docker/library/sonarqube|(?:docker\\.io/library/)?sonarqube",
        "tagPattern": "(\\d{2}\\.\\d+\\.\\d+\\.\\d+)-community"
      },
      "source": {
        "kind": "github",
        "repo": "SonarSource/sonarqube",
        "pattern": "(\\d{2}\\.\\d+\\.\\d+\\.\\d+)"
      },
      "note": "Verify the custom branch plugin and database upgrade path before updating."
    },
    {
      "name": "Keycloak",
      "installed": {
        "imagePattern": "quay\\.io/keycloak/keycloak",
        "tagPattern": "v?(\\d+\\.\\d+\\.\\d+)"
      },
      "source": {
        "kind": "github",
        "repo": "keycloak/keycloak",
        "pattern": "v?(\\d+\\.\\d+\\.\\d+)"
      },
      "note": ""
    },
