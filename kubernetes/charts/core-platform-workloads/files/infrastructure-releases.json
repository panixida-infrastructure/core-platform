    {
      "name": "Node Exporter",
      "installed": {
        "imagePattern": "quay\\.io/prometheus/node-exporter",
        "tagPattern": "v?(\\d+\\.\\d+\\.\\d+)"
      },
      "source": {
        "kind": "github",
        "repo": "prometheus/node_exporter",
        "pattern": "v?(\\d+\\.\\d+\\.\\d+)"
      },
      "note": ""
