    {
      "name": "OpenTelemetry Collector",
      "installed": {
        "imagePattern": "(?:docker\\.io/)?otel/opentelemetry-collector-contrib",
        "tagPattern": "v?(\\d+\\.\\d+\\.\\d+)"
      },
      "source": {
